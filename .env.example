# ============================================================
# Reactive Drop 服务器配置
# 复制为 .env 后修改: cp .env.example .env
# ============================================================

# ---- 服务器基础设置 ----
# 端口(TCP+UDP,请同步放行防火墙/安全组)
PORT=22333
# 最大玩家数
MAXPLAYERS=16
# tickrate(机器性能好可尝试 128)
TICKRATE=100

# ---- CPU 限制(多实例时建议设置) ----
# 用 cpuset 把本服务器固定到指定核心, 避免多个实例互相争抢 CPU。
# 留空(保持注释)= 不限制。示例: 0(单核)、0-3(0~3 号核心)、0,2(0 和 2 号核心)
# 查看核心数: nproc 或 lscpu
CPUSET=0,1,2

# ---- Docker 镜像加速 ----
# 构建镜像时需要从 Docker Hub 拉取 debian:bookworm-slim 基础镜像, 国内经常超时。
# 镜像加速配置在仓库根目录的 daemon.json(registry-mirrors), setup.sh 会自动复制到
# /etc/docker/daemon.json 并重启 Docker。需要改镜像源时直接编辑 daemon.json 即可。
# 也可本地 docker pull + docker save 上传基础镜像到 downloads/, 见 downloads/README.md。

# ---- 游戏配置说明 ----
# rcon 密码、服务器名、rd_* 等不再通过环境变量传入。
# 安装完成后,把你自己的配置文件上传到 reactivedrop/reactivedrop/cfg/:
#   server.cfg / autoexec.cfg -> 服务器各项设置(含 rcon_password、hostname 等)
#   workshop.cfg             -> 创意工坊,每行一个: rd_enable_workshop_item <id>
